---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import JarvisCopilot from '../components/copilot/JarvisCopilot';
import ModuleGrid from '../components/3D/ModuleGrid';
import '../styles/global.css';
---

<Layout title="Algorixis Innova | Transformación Digital e IA">
  <main>
    <!-- Hero Section con fondo degradado garantizado -->
    <header class="min-h-screen flex flex-col items-center justify-center text-center px-4 relative overflow-hidden" style="background: radial-gradient(ellipse at center, rgba(0, 102, 255, 0.15) 0%, rgba(0, 0, 0, 1) 70%);">
      <div class="z-10 max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-7xl font-bold mb-6 gradient-title">Algorixis Innova</h1>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">Transformación Digital, Inteligencia Artificial y Automatización de Procesos para empresas que lideran el futuro.</p>
        <a href="#modulos" class="inline-block px-8 py-4 bg-[#0066ff] hover:bg-[#00d4ff] text-white rounded-xl font-semibold transition-all shadow-lg shadow-blue-500/30 hover:scale-105">Explorar Soluciones</a>
      </div>
      
      <!-- Efecto de grilla sutil de fondo -->
      <div class="absolute inset-0 z-0 opacity-20" style="background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px); background-size: 40px 40px;"></div>
    </header>

    <!-- Módulos 3D -->
    <ModuleGrid client:visible />
    
    <!-- JARVIS -->
    <JarvisCopilot client:only="react" />
  </main>
</Layout>
